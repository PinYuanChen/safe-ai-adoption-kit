#!/usr/bin/env bash
# Blocks commits that contain secrets. Enabled with: git config core.hooksPath .githooks
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is not installed (brew install gitleaks); refusing to commit unscanned changes." >&2
  exit 1
fi

gitleaks git --pre-commit --staged --redact --no-banner
