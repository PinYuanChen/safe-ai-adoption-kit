{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/Library/Keychains/**)",
      "Bash(*.env*)",
      "Bash(*security find-*)",
      "Bash(*security dump-keychain*)",
      "Bash(*security export*)",
      "Bash(*--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(*core.hooksPath*)",
      "Bash(*gitleaks*--no-git*)",
      "Bash(*.githooks*)",
      "Bash(*with-secrets*)",
      "Edit(.claude/**)",
      "Edit(.githooks/**)"
    ],
    "ask": [
      "Edit(.github/workflows/**)",
      "Bash(git config *)",
      "Bash(git -c *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh",
            "statusMessage": "Checking command for secret access"
          }
        ]
      }
    ]
  }
}
